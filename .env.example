# Copy to .env for local development. Never commit .env.
#   cp .env.example .env

# Required in production — the app refuses to boot without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# How long an issued login token stays valid.
JWT_EXPIRES_IN=7d

# bcrypt cost factor. 12 is a solid default; only raise it if your host has
# CPU to spare, since every login/register pays this cost.
BCRYPT_ROUNDS=12

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Required in production — the externally-visible URL for this app (no
# trailing slash). Used to build the verification link embedded in every
# certificate PDF and QR code. Get this wrong and certificates link to a
# broken URL. Example: https://academy.example.com
PUBLIC_BASE_URL=http://localhost:3000

# Where the SQLite file lives. Must point at a writable, PERSISTENT path —
# on platforms without a persistent disk (many serverless/PaaS defaults),
# this file is wiped on every redeploy. The bundled docker-compose.yml
# mounts a named volume here for exactly this reason.
DB_PATH=./data/academy.db

# Set to 1 when this app sits behind exactly one reverse proxy (the bundled
# nginx config, or the Docker Compose setup) so req.ip and rate limiting see
# the real client IP instead of the proxy's. Leave as false if you're
# exposing this process directly with no proxy in front.
TRUST_PROXY=false

# Only needed if the frontend is served from a different origin than this
# API. Leave unset for the default same-origin monolith deployment.
CORS_ORIGIN=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Login attempts are throttled by BOTH the caller's IP (AUTH_RATE_LIMIT_MAX
# above) and the targeted account's email (below) — the second one is what
# catches credential stuffing spread across many source IPs at one account.
LOGIN_ACCOUNT_RATE_LIMIT_MAX=10

# Authenticated in-app lab terminal (per account) vs. the small unauthenticated
# homepage demo terminal (per IP) — see README "Phase 1" for why these are split.
LAB_RATE_LIMIT_MAX=120
LAB_DEMO_RATE_LIMIT_MAX=30
